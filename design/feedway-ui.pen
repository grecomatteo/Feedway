          ]
        },
        {
          "type": "text",
          "id": "Y5aHV",
          "name": "Descrizione",
          "fill": "#3A3835",
          "textGrowth": "fixed-width",
          "width": 5600,
          "content": "Bozze dell'hub per le tappe successive: cruscotto, CRM, calendario settimana, dettaglio del post, lavoro, shooting, report, guide, programmazione in blocco, notifiche, portale del cliente, Oggi da telefono. Disegnate il 29/10 con le regole Hallmark: si rifanno con i componenti del pannello quando arriva la loro tappa.",
          "lineHeight": 1.4,
          "fontFamily": "Inter",
          "fontSize": 20
        }
      ]
    },
    {
      "type": "frame",
      "id": "gVXiZ",
      "x": 0,
      "y": -4456,
      "name": "Leggimi · Tela unica di Feedway (18 novembre 2026)",
      "width": 2400,
      "fill": "#FFFFFF",
      "cornerRadius": 16,
      "stroke": "#E3DFD7",
      "strokeWidth": 1,
      "layout": "vertical",
      "gap": 28,
      "padding": 56,
      "children": [
        {
          "type": "text",
          "id": "PxZvX",
          "name": "Titolo",
          "fill": "#242321",
          "content": "Feedway · tela unica",
          "fontFamily": "Sora",
          "fontSize": 44,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "XJ3Gg",
          "name": "Intro",
          "fill": "#242321",
          "textGrowth": "fixed-width",
          "width": 1800,
          "content": "Qui c'è tutto il design di Feedway, solo nell'ultima versione: marchio, variabili e componenti, pannello com'è nel codice, email, landing, direzione hub e bozze delle funzioni future. Dal 18 novembre 2026 sostituisce design/feedway-ui.pen e design/feedway-ui-hallmark.pen; le versioni superate sono state tolte e restano nella storia di Git. Le scelte approvate sono in DESIGN.md; se tela e codice non sono d'accordo, vale il codice per le pagine fatte e DESIGN.md per quelle da fare.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 17
        },
        {
