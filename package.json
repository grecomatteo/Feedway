{
  "name": "feedway",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm --filter @app/web exec nuxt prepare && node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch:check": "depcruise --config .dependency-cruiser.cjs apps packages",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:auth-contract": "vitest run packages/infrastructure/src/auth/contract --project integration && pnpm --filter @app/web exec playwright test -c tests/e2e/playwright.config.ts passkey-localhost --project desktop-light",
    "test:e2e": "turbo run test:e2e",
    "rules:table": "RULES_TABLE_WRITE=1 vitest run --project unit apps/web/tests/rules-table.test.ts",
    "db:generate": "pnpm --filter @app/infrastructure db:generate",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm arch:check && pnpm test:unit",
    "verify:ci": "scripts/ci/local.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,cjs,mjs,json,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "18.8.0",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "4.2.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
