{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "timezone": "Europe/Rome",
  "schedule": ["before 7am on monday"],
  "automerge": false,
  "platformAutomerge": false,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "infra",
  "commitMessageLowerCase": "auto",
  "labels": ["dipendenze"],
  "prConcurrentLimit": 5,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "design/**"
  ],
  "packageRules": [
    {
      "description": "Patch e minor insieme, una sola PR a settimana",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "aggiornamenti minor e patch"
    },
    {
      "description": "Better Auth: un aggiornamento passa solo se i test di contratto restano verdi (ADR 012)",
      "matchPackageNames": ["better-auth", "@better-auth/**"],
      "groupName": "better-auth",
      "prBodyNotes": [
        "Prima di unire: `pnpm test:auth-contract` verde e sezione \"Verifiche della tappa 2\" di ADR 012 ancora vera."
      ]
    }
  ]
}
