# Valori finti: i segreti veri stanno in secrets/ (vedi docs/runbooks/installazione.md).
# Ogni variabile accetta anche la forma NOME_FILE (percorso di un file con il valore).
NODE_ENV=development
DATABASE_URL=postgres://app_runtime:cambiami@localhost:5432/app
DATABASE_MIGRATOR_URL=postgres://app_migrator:cambiami@localhost:5432/app
DATABASE_RUNTIME_ROLE=app_runtime
# 32 byte casuali in base64, per esempio: openssl rand -base64 32
APP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Solo web: firma le sessioni. 32 byte casuali in base64, come sopra.
BETTER_AUTH_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Facoltativa, per cambiare il segreto: 2:nuovo,1:vecchio. Il nuovo firma i cookie, quindi tutte
# le sessioni si chiudono; i dati cifrati (2FA) restano leggibili con le versioni vecchie e con
# BETTER_AUTH_SECRET, che resta obbligatoria.
# BETTER_AUTH_SECRETS=
PANEL_URL=http://localhost:3000
# Host pubblico dei media (/m/*): host diverso da PANEL_URL. Vuota: spento
# PUBLIC_URL=
META_GRAPH_VERSION=v25.0
# Data di ritiro della versione (AAAA-MM-GG). Feedway la conosce per v24.0 e v25.0; se la imposti,
# vale al posto di quella nota: toglila quando torni a una versione nota
# META_GRAPH_VERSION_SUNSET=
META_MODE=mock
# Solo con META_MODE=mock: il finto Graph API (pnpm --filter @app/meta-mock start)
# META_MOCK_URL=http://127.0.0.1:4010
# Solo con META_MODE=live, per la prova su Meta vera: salva le risposte già oscurate in questa cartella.
# Nel container scegli una cartella del volume media (/media/meta-record): il resto è in sola lettura.
# Spegnila a fine prova (tools/meta-mock/README.md)
# META_RECORD_DIR=
TZ_DEFAULT=Europe/Rome
MEDIA_RETENTION_DAYS=7
# Cartella dei file (foto profilo, esportazioni); nel container è il volume media
# MEDIA_ROOT=/media
# Pezzi dei caricamenti in corso, sul disco del web (ADR 021)
# MEDIA_UPLOAD_DIR=/media/uploads
# Limiti dei file, in byte e pixel (larghezza × altezza); questi sono i predefiniti
# MEDIA_MAX_VIDEO_BYTES=300000000
# MEDIA_MAX_IMAGE_BYTES=50000000
# MEDIA_MAX_IMAGE_PIXELS=50000000
# MEDIA_MAX_VIDEO_SECONDS=900
# MEDIA_MAX_VIDEO_PIXELS=16777216
# Spazio massimo per cliente, in byte; vuota: nessun limite oltre quello dell'agenzia
# MEDIA_WORKSPACE_MAX_BYTES=
# MEDIA_CONVERSIONS_PER_ORG=1
# Dove stanno i file: disk (predefinito) o s3. Con s3 servono bucket e chiavi
# STORAGE_DRIVER=disk
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=1
REQUIRE_2FA=admins
# BOOTSTRAP_OWNER_EMAIL=
# Nome della prima agenzia (predefinito: "La mia agenzia")
# BOOTSTRAP_ORGANIZATION_NAME=
# SENTRY_DSN=
LOG_LEVEL=info
# Solo worker: all oppure elenco separato da virgole
WORKER_QUEUES=all
