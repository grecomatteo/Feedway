{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".output/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test:int": { "cache": false },
    "test:e2e": { "cache": false, "passThroughEnv": ["PLAYWRIGHT_CHROMIUM_PATH"] }
  }
}
